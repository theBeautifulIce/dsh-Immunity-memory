{
  "name": "dsh-memory-plugin",
  "version": "0.4.26",
  "description": "dsh-Immunity-memory: cross-session long-term memory for DeepSeek Harness with eight layers, notebooks, hybrid retrieval, write hooks, automatic capture triggers, conflict resolution, forgetting curve, project spaces, diagnostics and a visual UI.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theBeautifulIce/dsh-Immunity-memory.git"
  },
  "homepage": "https://github.com/theBeautifulIce/dsh-Immunity-memory#readme",
  "bugs": {
    "url": "https://github.com/theBeautifulIce/dsh-Immunity-memory/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "记忆插件 (dsh-memory-plugin)",
    "description": "给 DeepSeek Harness 的跨会话长期记忆：八层记忆、四本记事本、混合检索、自动捕获触发、冲突合并、遗忘曲线、项目空间、写入生命周期 Hook、诊断与可视化界面。"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "retrieval"
  ],
  "license": "MIT"
}
